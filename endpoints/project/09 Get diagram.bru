meta {
  name: 09 Get diagram
  type: http
  seq: 9
}

get {
  url: http://localhost:8080/api/v1/projects/{{projectId}}/diagrams/{{diagramId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("returns the diagram with viewData", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.id).to.equal(bru.getEnvVar("diagramId"));
    expect(data).to.have.property("viewData");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
