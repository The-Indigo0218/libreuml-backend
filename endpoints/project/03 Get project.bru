meta {
  name: 03 Get project
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/api/v1/projects/{{projectId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("returns project detail with diagram summaries", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.id).to.equal(bru.getEnvVar("projectId"));
    expect(data).to.have.property("diagrams");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
