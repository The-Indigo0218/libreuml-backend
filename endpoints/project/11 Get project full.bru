meta {
  name: 11 Get project full
  type: http
  seq: 11
}

get {
  url: http://localhost:8080/api/v1/projects/{{projectId}}/full
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("returns project + model + diagrams in one payload", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data).to.have.property("project");
    expect(data).to.have.property("model");
    expect(data).to.have.property("diagrams");
    expect(data.diagrams).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
