meta {
  name: 10 Update diagram
  type: http
  seq: 10
}

patch {
  url: http://localhost:8080/api/v1/projects/{{projectId}}/diagrams/{{diagramId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Domain Model (v2)",
    "viewData": {
      "nodes": [
        { "id": "n1", "x": 100, "y": 120 },
        { "id": "n2", "x": 300, "y": 200 }
      ],
      "edges": [{ "id": "e1", "from": "n1", "to": "n2" }]
    },
    "version": {{diagramVersion}}
  }
}

tests {
  test("updates the diagram and bumps version", function() {
    expect(res.getStatus()).to.equal(200);
    bru.setEnvVar("diagramVersion", res.getBody().version);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
