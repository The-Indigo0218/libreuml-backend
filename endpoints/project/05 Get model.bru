meta {
  name: 05 Get model
  type: http
  seq: 5
}

get {
  url: http://localhost:8080/api/v1/projects/{{projectId}}/model
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("returns the semantic model", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.projectId).to.equal(bru.getEnvVar("projectId"));
    bru.setEnvVar("modelVersion", data.version);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
