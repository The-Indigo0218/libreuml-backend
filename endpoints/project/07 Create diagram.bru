meta {
  name: 07 Create diagram
  type: http
  seq: 7
}

post {
  url: http://localhost:8080/api/v1/projects/{{projectId}}/diagrams
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Domain Model",
    "diagramType": "DOMAIN",
    "path": "diagram-1",
    "viewData": {
      "nodes": [{ "id": "n1", "x": 100, "y": 120 }],
      "edges": []
    }
  }
}

tests {
  test("creates a diagram in the project", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    expect(data.projectId).to.equal(bru.getEnvVar("projectId"));
    bru.setEnvVar("diagramId", data.id);
    bru.setEnvVar("diagramVersion", data.version);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
