meta {
  name: 06 Update model
  type: http
  seq: 6
}

patch {
  url: http://localhost:8080/api/v1/projects/{{projectId}}/model
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "data": {
      "elements": [
        { "id": "User", "kind": "CLASS", "attributes": ["id", "name"] }
      ]
    },
    "version": {{modelVersion}}
  }
}

tests {
  test("updates the model and bumps version", function() {
    expect(res.getStatus()).to.equal(200);
    bru.setEnvVar("modelVersion", res.getBody().version);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
